# Copy this file to .env and fill in your values before running the app.

# The URL of the deployed web app. Used by the desktop to open upgrade pages
# in the system browser. No trailing slash.
WEB_APP_URL=https://your-app-domain.com

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# HatchLog NestJS API (Option A). Local Windows desktop uses localhost.
HATCHLOG_API_URL=http://198.211.106.127:3001
